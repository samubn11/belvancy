---
import '../styles/global.css';
import Icon from '../components/Icon.astro';

const { title, description } = Astro.props;
const fullTitle = title ? `${title} · Belvancy` : 'Belvancy — Derecho laboral explicado sin rodeos';
const desc = description || 'Guías claras y calculadoras sobre despidos, finiquitos, nóminas y prestaciones en España.';
---
<!doctype html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{fullTitle}</title>
  <meta name="description" content={desc} />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <meta property="og:type" content="website" />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={desc} />
  <meta property="og:site_name" content="Belvancy" />
  <meta name="theme-color" content="#2F5D50" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Source+Serif+4:wght@500;600;700&family=IBM+Plex+Sans:wght@400;500;600&display=swap" rel="stylesheet" />
  
  <!-- Cookie Consent (GDPR) -->
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/orestbida/cookieconsent@v2.9.0/dist/cookieconsent.css" />
  <script defer src="https://cdn.jsdelivr.net/gh/orestbida/cookieconsent@v2.9.0/dist/cookieconsent.js"></script>

  <!-- Google Search Console Verification -->
  <meta name="google-site-verification" content="s5orMxt8Z5_DfKVkbJsLLWADIemBTqcZzt1ut7pjD4k" />
</head>
<body>
  <header class="site-header">
    <div class="wrap">
      <a href="/" class="brand"><span class="brand-mark"><Icon name="seal" size={20} /></span>Belvancy<small>Derecho laboral, explicado</small></a>
      <nav class="main-nav">
        <a href="/despidos">Despidos</a>
        <a href="/finiquitos">Finiquitos</a>
        <a href="/nominas">Nóminas</a>
        <a href="/contratos">Contratos</a>
        <a href="/seguridad-social">Seguridad Social</a>
        <a href="/erte-paro">ERTE y paro</a>
      </nav>
    </div>
  </header>

  <main>
    <slot />
  </main>

  <footer class="site-footer">
    <div class="wrap">
      <span>© {new Date().getFullYear()} Belvancy. Contenido informativo, no constituye asesoramiento jurídico.</span>
      <span>
        <a href="/sobre-mi">Sobre mí</a> · <a href="/contacto">Contacto</a> · <a href="/aviso-legal">Aviso legal</a> · <a href="/politica-privacidad">Privacidad</a> · <a href="/cookies">Cookies</a>
      </span>
    </div>
  </footer>
</body>
</html>
